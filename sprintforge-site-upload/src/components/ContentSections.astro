---
import SectionHeading from './SectionHeading.astro';
const services = [
  ['01','Le mental','Faire ce qui est nécessaire même sans envie. Rebondir après un refus. Tenir dans la durée.'],
  ['02','Les techniques de vente','Prospection, découverte, qualification, argumentation, objections et négociation. La technique reste indispensable.'],
  ['03','La réalité psychologique du métier','Comprendre ce qui se joue vraiment pour un commercial, au-delà de ce qu’il dit ou montre.'],
  ['04','Le passage à l’action','Travailler les freins qui empêchent d’appliquer les méthodes déjà connues.'],
  ['05','Les situations réelles','Partir des rendez-vous, des opportunités et des difficultés vécues sur le terrain.'],
  ['06','Le potentiel de progression','Concentrer le travail là où le commercial peut réellement franchir un cap.'],
];
const nonDits = [
  ['LA SATURATION','Ils ont déjà vu les mêmes méthodes.','Les commerciaux ont parfois suivi les mêmes formations des dizaines de fois. Une méthode de plus ne suffit pas à créer un changement.'],
  ['LE TRANSFERT','Deux jours de formation. Dix jours plus tard, qu’en reste-t-il ?','Sans travail dans la durée, les apports d’une formation peuvent s’effacer avant d’être devenus des réflexes.'],
  ['LE VRAI LEVIER','La technique ne fait pas tout.','Savoir quoi faire ne garantit pas de le faire. Le mental pèse lourd au moment d’agir, sans remplacer la maîtrise des techniques.'],
];
const accompaniments = [
  {name:'Accompagnement individuel', label:'MENTAL + TECHNIQUE', text:'Un travail sur mesure, construit à partir du profil, du marché et des situations vécues.', items:['Un échange avec l’entreprise','Un échange avec le commercial','Un plan adapté, pas un programme plaqué']},
  {name:'Travail au plus près du terrain', label:'ACTIONS + SUIVI', featured:true, text:'On choisit les leviers prioritaires et on les travaille dans les situations commerciales réelles.', items:['Des objectifs concrets','Un suivi dans la durée','Des ajustements au fil du terrain']},
  {name:'Ressources et appui', label:'ENTRE LES SÉANCES', text:'Des supports et des points de contact pour faire vivre le travail au quotidien.', items:['Ressources audio et vidéo','Supports adaptés au profil','Appui sur les opportunités en cours']},
];
---
<main>
  <section class="section" id="non-dits">
    <SectionHeading label="Les non-dits du marché" title="Le problème n’est pas toujours le manque de formation." copy="Les commerciaux ont déjà entendu les conseils. Ce qui manque, c’est souvent un changement qui tient quand ils retournent sur le terrain." />
    <div class="service-grid">{nonDits.map(([label,title,copy]) => <article class="service-card reveal"><span class="service-icon">{label}</span><h3>{title}</h3><p>{copy}</p></article>)}</div>
  </section>

  <section class="section proof-section"><div class="proof-panel"><div class="metric"><strong>150<i>+</i></strong><span>profils accompagnés</span></div><div class="metric metric-featured"><strong>4,9 <i>/ 5</i></strong><span>Trust Score, basé sur 106 avis</span></div><div class="metric"><strong>15 <i>ans</i></strong><span>au contact des commerciaux</span></div><small>Chiffres affichés sur le site ClozingSystem. Le Trust Score et le nombre d’avis peuvent évoluer.</small></div></section>

  <section class="section" id="approche"><SectionHeading label="La différence ClozingSystem" title="Le mental au cœur. La technique au service de l’action." copy="La technique reste essentielle. Mais elle ne sert à rien si le commercial n’arrive pas à l’utiliser quand ça compte." /><div class="dark-panel"><article class="dark-feature"><h3>Pas une formation <span>de plus.</span></h3><p>On ne déroule pas un catalogue de modules. On comprend le profil, son marché et ce qui bloque. Puis on travaille le levier qui peut vraiment le faire avancer.</p><div class="workflow-art"><span>Comprendre</span><b>→</b><span class="demo-token">Prioriser</span><b>→</b><span>Agir</span></div></article><article class="dark-feature speed-feature"><span class="orange-tag">SUR MESURE</span><div class="bars"><i></i><i></i><i></i><i></i><i></i></div><p>Pas de trame universelle. Le travail s’adapte au commercial et au terrain.</p></article><article class="dark-feature wide-feature"><span class="orange-tag">MENTAL + TECHNIQUE</span><h3>Surprendre pour <span>faire bouger.</span></h3><p>Sortir des schémas standards de formation. Aborder ce qui est évité. Transformer les prises de conscience en actes concrets.</p></article><article class="dark-feature"><h3>Un regard <span>extérieur.</span></h3><p>Un cadre individuel et confidentiel pour parler franchement, sans enjeu hiérarchique. Le commercial garde le dernier mot sur son engagement.</p></article></div></section>

  <section class="section" id="potentiel"><SectionHeading label="Choisir où investir" title="Tous les commerciaux n’ont pas le même potentiel de progression." copy="L’accompagnement se concentre sur les profils qui peuvent aller plus loin. Le but n’est pas de faire suivre le même parcours à tout le monde." /><div class="case-list"><article class="case-card reveal"><div class="case-copy"><span class="time-pill">LE BON PROFIL</span><h3>Repérer la marge de progression.</h3><div class="case-details"><div><b>Ce qu’on regarde</b><p>Le potentiel du commercial, ses capacités, son envie et sa réalité de terrain.</p></div><div><b>Ce qu’on choisit</b><p>Le frein principal et les quelques leviers qui peuvent faire la différence.</p></div><div><b>Ce qu’on évite</b><p>Investir dans un parcours standard sans vérifier s’il correspond à la personne.</p></div></div></div><div class="case-visual" aria-hidden="true"><div class="mock-window"><span class="mock-dots">POTENTIEL · LEVIERS · TERRAIN</span><i></i><i></i><i></i><i></i><b></b></div></div></article></div></section>

  <section class="section" id="accompagnement"><div class="packages-panel"><SectionHeading centered label="L’accompagnement" title="Un travail ciblé. Pas un catalogue." copy="Le contenu se construit à partir de la situation de l’entreprise et du commercial. Les sujets évoluent avec le terrain."/><div class="package-grid">{accompaniments.map(item => <article class:list={['package-card',{featured:item.featured}]}><div class="package-title"><h3>{item.name}</h3>{item.featured && <span class="orange-tag">AU PLUS PRÈS DU TERRAIN</span>}</div><p class="duration">{item.label}</p><p class="package-description">{item.text}</p><ul>{item.items.map(point => <li><span>✓</span>{point}</li>)}</ul><a class="button" href="#contact">En parler</a></article>)}</div><p class="disclaimer">Le format et la durée se définissent selon le besoin. Aucun tarif n’est affiché ici.</p></div></section>

  <section class="section studio-section" id="apropos"><SectionHeading label="Maxime Koziol · ClozingSystem" title="Du direct. Du sur-mesure. Pas de pirouette."/><div class="studio-grid"><article class="studio-card studio-quote"><span>LE CADRE</span><blockquote>Un espace individuel et confidentiel où le commercial peut parler franchement.</blockquote><small>Le commercial garde le dernier mot sur son engagement.</small></article><article class="studio-card studio-photo"><strong>ClozingSystem</strong><small>MENTAL · TECHNIQUE · TERRAIN</small><a href="#contact">Parlons-en</a></article><article class="studio-card studio-concept"><small>→ MA CONVICTION</small><p><b>Former encore ne suffit pas.</b> Je travaille avec les commerciaux à fort potentiel de progression pour les surprendre, sortir des schémas standards et faire évoluer ce qu’ils font réellement sur le terrain.</p><a href="mailto:contact@clozingsystem.com">contact@clozingsystem.com</a><span>Accompagnement mental et technique des commerciaux</span></article></div></section>
</main>
