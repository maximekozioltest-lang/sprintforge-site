---
import SectionHeading from './SectionHeading.astro';
const services = [
  ['⌘','AI workflow prototype','A clickable, model-connected prototype of one core workflow, ready for stakeholder testing.','8 days'],
  ['▤','Internal copilot','A private assistant grounded in your docs, tools, and data — deployed where your team works.','2 weeks'],
  ['◉','Support automation','Triage, drafting, and resolution flows layered on your existing helpdesk with human review built in.','3 weeks'],
  ['▧','Data assistant','Natural-language querying over your warehouse, with guardrails and saved answers your team trusts.','3 weeks'],
  ['✎','Content pipeline','Structured generation, review, and publishing flows tuned to your brand voice and approval loops.','2 weeks'],
  ['↗','Launch-page system','A modular launch page and messaging kit so your AI feature ships with a story, not just a toggle.','2 weeks'],
];
const cases = [
  ['Fintech · Prototype Sprint','Reconciliation copilot for Alderpay','Ops spent hours matching mismatched transactions by hand every week.','A matching assistant with confidence scoring and a review queue.','Internal tool in production, wired to their existing ledger API.'],
  ['Logistics · Launch Sprint','Dispatch assistant for Vantrail','Dispatchers juggled five tools to answer one driver question.','A single chat surface that pulls routes, ETAs, and exceptions.','Slack-native assistant, live across three regional hubs.'],
  ['SaaS · Operating System Sprint','Content engine for Fernwave',"Marketing couldn't keep release notes and docs in sync at scale.",'A drafting pipeline with tone controls and human approval gates.','A full publishing system with CMS hooks and analytics.'],
];
const packages = [
  {name:'Prototype Sprint', duration:'8 days · one workflow', price:'$9k', features:['Discovery workshop + workflow map','Model-connected clickable prototype','Validation report + next-step plan'], cta:'Start a Prototype Sprint'},
  {name:'Launch Sprint', duration:'4 weeks · production build', price:'$28k', featured:true, features:['Everything in Prototype Sprint','Production integration into your stack','Evaluation suite + guardrails','Team handover + launch support'], cta:'Book a Launch Sprint'},
  {name:'Operating System Sprint', duration:'8 weeks · full system', price:'$52k', features:['Multi-workflow AI operating layer','Shared model + data infrastructure','Internal enablement + playbooks'], cta:'Scope an OS Sprint'},
];
---
<main>
  <section class="section" id="services">
    <SectionHeading label="Services" title="What we build in a sprint." copy="Six focused delivery lanes. Each one arrives as a working artifact inside your stack — not a slide deck." />
    <div class="service-grid">{services.map(([icon, title, copy, time]) => <article class="service-card reveal"><span class="service-icon">{icon}</span><h3>{title}</h3><p>{copy}</p><span class="time-pill">◷ &nbsp;Ships in {time}</span></article>)}</div>
  </section>
  <section class="section proof-section"><div class="proof-panel"><div class="metric"><strong>8 <i>days</i></strong><span>to a working prototype</span></div><div class="metric metric-featured"><strong>4 <i>demos</i></strong><span>live stakeholder demos per sprint</span></div><div class="metric"><strong>1 <i>system</i></strong><span>launch-ready and handed over</span></div><small>Sample sprint metrics shown for illustration — your engagement plan defines the real numbers.</small></div></section>
  <section class="section" id="capabilities"><SectionHeading label="How we work" title="One team. Every sprint." /><div class="dark-panel"><article class="dark-feature"><h3>Full-cycle <span>sprint delivery</span></h3><p>Scope, build, and demo AI features in one continuous loop — detailed briefs, model-connected prototypes, and live stakeholder walkthroughs.</p><div class="workflow-art"><span>Scope</span><b>→</b><span class="demo-token">Demo day</span><b>→</b><span>Ship</span></div></article><article class="dark-feature speed-feature"><span class="orange-tag">3× faster</span><div class="bars"><i></i><i></i><i></i><i></i><i></i></div><p>Median time from idea to shipped feature</p></article><article class="dark-feature wide-feature"><span class="orange-tag">↗ Prototype → Production</span><h3>Prototype-to-launch <span>synergy</span></h3><p>Move seamlessly from validating an idea to launching and scaling it — without switching teams, tools, or contracts.</p></article><article class="dark-feature"><h3>Integrated <span>handover</span></h3><p>Own everything after we leave — evals, guardrails, monitoring, and playbooks your team actually runs.</p></article></div></section>
  <section class="section" id="work"><SectionHeading label="Recent builds" title="Sprints that shipped." /><div class="case-list">{cases.map(([category,title,problem,output,shipped], i) => <article class:list={['case-card','reveal',{reverse:i===1}]}><div class="case-copy"><span class="time-pill">{category}</span><h3>{title}</h3><div class="case-details"><div><b>Problem</b><p>{problem}</p></div><div><b>Sprint output</b><p>{output}</p></div><div><b>Shipped artifact</b><p>{shipped}</p></div></div></div><div class="case-visual" aria-hidden="true"><div class="mock-window"><span class="mock-dots">● ● ●</span><i></i><i></i><i></i><i></i><b></b></div></div></article>)}</div></section>
  <section class="section" id="packages"><div class="packages-panel"><SectionHeading centered label="Packages" title="Pick the sprint that fits." copy="Fixed scope, fixed timeline, real deliverables. Every package ends with something running in your stack."/><div class="package-grid">{packages.map(pkg => <article class:list={['package-card',{featured:pkg.featured}]}><div class="package-title"><h3>{pkg.name}</h3>{pkg.featured && <span class="orange-tag">Most booked</span>}</div><p class="duration">{pkg.duration}</p><strong class="price">{pkg.price}<small> / sprint</small></strong><ul>{pkg.features.map(feature => <li><span>✓</span>{feature}</li>)}</ul><a class="button" href="#contact">{pkg.cta}</a></article>)}</div><p class="disclaimer">Prices shown are sample placeholders — final scope is confirmed on a discovery call.</p></div></section>
  <section class="section studio-section"><SectionHeading label="Studio" title="The team behind the sprints."/><div class="studio-grid"><article class="studio-card studio-quote"><span>AI&nbsp;&nbsp; Product</span><blockquote>“We don't just demo models. We ship AI systems teams are still running a year later.”</blockquote><small>— Lena Kort, AI Systems Lead</small></article><article class="studio-card studio-photo"><strong>SprintForge©</strong><small>Since '21</small><a href="#work">View work</a></article><article class="studio-card studio-concept"><small>→ Concept</small><p><b>Don't just plug in a model.</b> Wire intelligence into the workflows people already use. Every prompt is a decision. Every guardrail, a promise. This is AI as infrastructure — shaped by shipping.</p><a href="mailto:hello@sprintforge.studio">hello@sprintforge.studio</a><span>+1 415 555 0134</span></article></div></section>
</main>
