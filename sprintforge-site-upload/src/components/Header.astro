---
const links = [['Le problème', '#non-dits'], ['L’approche', '#approche'], ['Accompagnement', '#accompagnement'], ['À propos', '#apropos']];
---
<div class="nav-wrap">
  <nav class="nav" aria-label="Navigation principale">
    <a class="brand" href="#top" aria-label="ClozingSystem, accueil"><span class="brand-mark" aria-hidden="true"><b>C</b><i></i></span><strong>ClozingSystem</strong></a>
    <div class="nav-links">{links.map(([label, href]) => <a href={href}>{label}</a>)}</div>
    <a class="button button-dark nav-cta" href="#contact">Parlons de vos commerciaux <span aria-hidden="true">↗</span></a>
    <button class="menu-button" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mobile-menu"><span></span><span></span></button>
  </nav>
  <div class="mobile-menu" id="mobile-menu" hidden>
    {links.map(([label, href]) => <a href={href}>{label}</a>)}
    <a class="button button-dark" href="#contact">Parlons de vos commerciaux</a>
  </div>
</div>
<script>
  const menuButton = document.querySelector<HTMLButtonElement>('.menu-button');
  const mobileMenu = document.querySelector<HTMLElement>('#mobile-menu');
  menuButton?.addEventListener('click', () => {
    const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
    menuButton.setAttribute('aria-expanded', String(!isExpanded));
    mobileMenu?.toggleAttribute('hidden', isExpanded);
  });
  mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
    mobileMenu.setAttribute('hidden', '');
    menuButton?.setAttribute('aria-expanded', 'false');
  }));
</script>
