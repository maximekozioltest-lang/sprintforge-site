---
interface Props { label: string; title: string; copy?: string; centered?: boolean }
const { label, title, copy, centered = false } = Astro.props;
---
<header class:list={['section-heading', { centered }]}>
  <p class="section-label">{label}</p><h2>{title}</h2>{copy && <p class="section-copy">{copy}</p>}
</header>
