---
import '../styles/global.css';
const title = 'SprintForge — Ship AI Products in Weeks, Not Quarters';
---
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="We embed with your team to scope, build, and launch AI features that make it past the demo." />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ECEDEE" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body><slot /></body>
</html>
